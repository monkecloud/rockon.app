node_modules
dist
.env
.DS_Store
APP_SPEC.txt
.claude/settings.local.json
.claude/worktrees/

# SQLite datastore (§14.3) -- unlike the users.json/climbs.json files it
# replaces, this is a binary file that changes on every mutation, so it's
# not tracked in git the way those were (§14.1 remains open/deferred on
# whether that should also apply retroactively to the JSON files still in
# the repo). Needs its own backup story outside git -- see the "Running it
# persistently" section of README.md.
server/climbing.db
server/climbing.db-wal
server/climbing.db-shm

# Migration-run output (scripts/migrate-json-to-sqlite.js) listing ascents
# that couldn't be matched to any climb -- includes usernames, so treated
# like the .db file above rather than committed.
server/orphaned-ascents.json

# Avatar/climb-photo uploads (§14.5 step 2) -- content-addressed files
# written by saveDataUrlImage in server/worker.js. A second piece of state
# alongside climbing.db; back it up the same way, outside git.
server/uploads/
