# Copy to .env for local development. .env is gitignored — never commit real values.
#
# These are for running the app on your own machine against your own local services. In
# the cluster the same variables are injected from Kubernetes Secrets, so nothing here is
# used by a deploy — see k8s/site.yaml and clusters/tamarin/apps/README.md in the infra repo.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rockon_dev
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rockon-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
