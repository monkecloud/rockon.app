# systemd unit for running this app persistently (e.g. on a home server or
# Raspberry Pi), serving the built frontend + API together on one port via
# `npm start` — see the "Running it persistently" section in README.md. This
# is the non-cluster, single-host deploy path; Dockerfile + k8s/ is the
# primary path now (Flux-applied on the Tamarin cluster), but this still
# works for self-hosting outside Kubernetes.
#
# As of the Postgres/S3 migration (§14.26), this app has no local SQLite
# file or local uploads directory to fall back to — DATABASE_URL and the
# S3_* vars below must be filled in with real values or it won't start.
#
# Install:
#   sudo cp deploy/climbing-app.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now climbing-app
#
# Adjust User/WorkingDirectory below to match where you cloned the repo.

[Unit]
Description=Climbing app (built frontend + API, served together)
After=network.target
# ExecStartPre re-runs the build on every restart, so a broken build (or
# poisoned data that crashes the app at import) would otherwise retry every
# 5s forever — a silent loop rather than a visible failure. Give up after 5
# restarts within 5 minutes and leave the unit in a failed state instead.
# These belong in [Unit]: systemd ignores them under [Service].
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=cubesnail
WorkingDirectory=/home/cubesnail/app/site
# Production mode: Express's default error handler only omits stack traces
# from 500 responses when this is set — see APP_REFERENCE.md §14.12. Safe to
# set regardless of how the app is reached (HTTP on the LAN, HTTPS through a
# reverse proxy) — the session cookie's `secure` flag is driven by the
# request itself (req.secure), not NODE_ENV.
Environment=NODE_ENV=production
# Required — no local-file fallback exists any more. Fill in real values.
#Environment=DATABASE_URL=postgresql://user:password@host:5432/dbname
#Environment=S3_ENDPOINT=https://s3.example.com
#Environment=S3_BUCKET=rockon
#Environment=S3_ACCESS_KEY=changeme
#Environment=S3_SECRET_KEY=changeme
# Rebuilds dist/ on every (re)start, so a `git pull` + restart always picks
# up the latest code without a separate manual `npm run build` step.
ExecStartPre=/usr/bin/npm run build
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
